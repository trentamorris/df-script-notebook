{
  "name": "@df-script/notebook",
  "version": "0.1.0",
  "description": "Interactive 2D spatial canvas notebook for df-script",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true });\"",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "df-script",
    "notebook",
    "dataframe",
    "canvas",
    "interactive",
    "react-notebook",
    "data-analysis"
  ],
  "author": "Trent Morris",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trentamorris/df-script.git",
    "directory": "df-script-notebook"
  },
  "bugs": {
    "url": "https://github.com/trentamorris/df-script/issues"
  },
  "homepage": "https://df-script.js.org",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^6.1.1",
    "@mui/material": "^6.1.1",
    "@mui/x-data-grid": "^8.29.5",
    "df-script": "^2.3.0",
    "marked": "^18.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-dts": "^4.5.4"
  }
}
